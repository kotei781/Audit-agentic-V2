# ============================================================
# Đổi tên file này thành ".env" rồi điền giá trị thật.
# KHÔNG commit file .env lên Git.
# KHÔNG dán key thật vào chat, log, hay ảnh chụp màn hình.
# ============================================================

# Bắt buộc — lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Khuyến nghị — chặn thao tác ghi ở vai trò Admin trên giao diện Streamlit.
# Để trống = ai cũng vào được màn Admin (chỉ chấp nhận khi demo cục bộ).
ADMIN_PASSWORD=

# --- Tùy chọn: model ---
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Tùy chọn: RAG ---
RAG_ENABLED=true
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
RAG_TOP_K=5

# --- Tùy chọn: kiểm soát chất lượng ---
GROUNDING_THRESHOLD=0.85
MIN_EXTRACTED_TEXT_LENGTH=200
MAX_UPLOAD_MB=25
LOG_LEVEL=INFO
